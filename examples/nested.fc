// nested.fc
// Demonstrates: nested loops and nested conditionals to stress-test lexical scoping.

// Part 1 — nested loops: multiplication table corner (rows 1-3, cols 1-3).
// Prints the product of each (row, col) pair.
rakm row = 1;
tol lma (row <= 3) {
    rakm col = 1;
    tol lma (col <= 3) {
        rakm product = row * col;
        etba3(product);
        col = col + 1;
    }
    row = row + 1;
}

// Part 2 — nested conditionals: classify a number as positive/negative/zero
//          and additionally mark it as even or odd (via remainder trick).
rakm val = 6;

lw (val > 0) {
    // positive — check even/odd using val - (val / 2) * 2
    rakm half = val / 2;
    rakm doubled = half * 2;
    rakm remainder = val - doubled;
    lw (remainder == 0) {
        etba3(1);
    } aw {
        etba3(0);
    }
} tb lw (val < 0) {
    etba3(2);
} aw {
    etba3(3);
}
